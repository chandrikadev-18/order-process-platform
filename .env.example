# ========================================================
# Order Processing Platform - Environment Configuration
# ========================================================

# API Gateway
PORT=3000
JWT_SECRET=super-secret-jwt-key-for-development-antigravity
JWT_EXPIRES_IN=24h

# PostgreSQL (Common for local / separate databases)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
GATEWAY_DB_NAME=gateway_db
ORDER_DB_NAME=order_db
INVENTORY_DB_NAME=inventory_db
NOTIFICATION_DB_NAME=notification_db

# Kafka Configuration
KAFKA_BROKERS=localhost:29092

# Service gRPC Ports & URLs
ORDER_GRPC_PORT=50051
INVENTORY_GRPC_PORT=50052
ORDER_GRPC_URL=localhost:50051
INVENTORY_GRPC_URL=localhost:50052
