# Multi-stage Dockerfile for inventory-service
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

COPY package*.json tsconfig*.json nest-cli.json ./
RUN npm ci

COPY proto ./proto
COPY libs ./libs
COPY apps/inventory-service ./apps/inventory-service

RUN npx nest build inventory-service

# Production runtime stage
FROM node:20-alpine AS runner

WORKDIR /usr/src/app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /usr/src/app/dist/apps/inventory-service ./dist/apps/inventory-service
COPY --from=builder /usr/src/app/proto ./proto

# Non-root user for security compliance
USER node

EXPOSE 50052

CMD ["node", "dist/apps/inventory-service/apps/inventory-service/src/main.js"]
